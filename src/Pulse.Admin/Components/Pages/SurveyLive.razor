@page "/surveys/{SessionId:guid}/live"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Pulse.Shared.Contracts.V1
@using Pulse.Shared.Services
@implements IAsyncDisposable
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ProtectedSessionStorage ProtectedStorage
@inject SessionRealtimeConnectionFactory RealtimeConnections
@inject ILogger<SurveyLive> Logger

<PageTitle>Live survey | Pulse</PageTitle>

<main class="pulse-page live-results-page">
    <header class="live-results-header">
        <div>
            <p class="pulse-eyebrow">Instructor live view</p>
            <h1>@(results?.Title ?? "Survey results")</h1>
            @if (!string.IsNullOrWhiteSpace(JoinCode))
            {
                <p>Join code: <strong>@JoinCode</strong></p>
            }
        </div>
        <a class="pulse-button pulse-button-secondary" href="/surveys">Back to surveys</a>
    </header>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="pulse-alert pulse-alert-error" role="alert">@error</div>
    }
    else if (results is null)
    {
        <section class="pulse-card live-loading" aria-live="polite">Loading live results...</section>
    }
    else
    {
        <section class="live-stat-grid" aria-label="Survey participation">
            <div class="pulse-card live-stat">
                <strong>@results.ParticipantCount</strong>
                <span>Participants</span>
            </div>
            <div class="pulse-card live-stat">
                <strong>@results.CompletedCount</strong>
                <span>Completed surveys</span>
            </div>
        </section>

        <div class="live-actions">
            <button class="pulse-button pulse-button-secondary" @onclick="CloseAsync">Close survey</button>
            <button class="pulse-button pulse-button-primary" @onclick="RevealAsync">Reveal results</button>
        </div>

        <section class="live-question-grid">
            @foreach (var question in results.Questions)
            {
                <article class="pulse-card live-question">
                    <div class="live-question-title">
                        <h2>@question.Text</h2>
                        <span>@question.ResponseCount responses</span>
                    </div>
                    @foreach (var tally in question.Tallies)
                    {
                        var percentage = question.ResponseCount == 0
                            ? 0
                            : (int)Math.Round(tally.Count * 100d / question.ResponseCount);
                        <div class="result-row">
                            <div><span>@tally.Value</span><strong>@tally.Count</strong></div>
                            <progress value="@tally.Count" max="@Math.Max(1, question.ResponseCount)">@percentage%</progress>
                        </div>
                    }
                </article>
            }
        </section>
    }
</main>

@code {
    [Parameter] public Guid SessionId { get; set; }
    [SupplyParameterFromQuery] public string JoinCode { get; set; } = string.Empty;

    private readonly CancellationTokenSource lifetime = new();
    private InstructorSurveyResultsResponse? results;
    private SessionRealtimeConnection? realtimeConnection;
    private string instructorCode = string.Empty;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var storedCode = await ProtectedStorage.GetAsync<string>("instructorCode");
        instructorCode = storedCode.Success ? storedCode.Value ?? string.Empty : string.Empty;
        if (string.IsNullOrWhiteSpace(instructorCode))
        {
            Navigation.NavigateTo("/surveys");
            return;
        }

        await RefreshAsync();
        realtimeConnection = RealtimeConnections.Create(
            _ => InvokeAsync(RefreshAsync),
            () => InvokeAsync(RefreshAsync),
            () => InvokeAsync(RefreshAsync));
        try
        {
            await realtimeConnection.StartAsync(SessionId, lifetime.Token);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Live updates unavailable for survey {SessionId}; polling will continue", SessionId);
        }

        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(RefreshAsync);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync()
    {
        using var request = AuthorizedRequest(HttpMethod.Get, $"/api/sessions/{SessionId}/results");
        var response = await Http.SendAsync(request, lifetime.Token);
        if (!response.IsSuccessStatusCode)
        {
            error = "Pulse could not load the live survey results.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        results = await response.Content.ReadFromJsonAsync<InstructorSurveyResultsResponse>(
            cancellationToken: lifetime.Token);
        error = results is null ? "Pulse returned an invalid live-results response." : null;
        await InvokeAsync(StateHasChanged);
    }

    private Task CloseAsync() => PerformActionAsync("close", "Pulse could not close this survey.");

    private Task RevealAsync() => PerformActionAsync("unblind", "Pulse could not reveal these results.");

    private async Task PerformActionAsync(string action, string failureMessage)
    {
        using var request = AuthorizedRequest(HttpMethod.Put, $"/api/sessions/{SessionId}/{action}");
        var response = await Http.SendAsync(request, lifetime.Token);
        if (!response.IsSuccessStatusCode)
        {
            error = failureMessage;
            await InvokeAsync(StateHasChanged);
            return;
        }

        error = null;
        await RefreshAsync();
    }

    private HttpRequestMessage AuthorizedRequest(HttpMethod method, string path)
    {
        var request = new HttpRequestMessage(method, path);
        request.Headers.TryAddWithoutValidation("InstructorCode", instructorCode);
        return request;
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        if (realtimeConnection is not null)
            await realtimeConnection.DisposeAsync();
        lifetime.Dispose();
    }
}
