@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<a class="pulse-skip-link" href="#main-content">Skip to main content</a>
<div class="admin-shell">
    <header class="admin-header">
        <a class="pulse-brand" href="/" aria-label="Pulse instructor home">
            <img src="/images/pulse_logo.png" height="100" alt="Pulse logo" />
            <span></span>
            <span class="admin-product-name">Instructor</span>
        </a>
        <span class="admin-header-label">Classroom engagement workspace</span>
    </header>
    <div class="admin-body">
        <aside class="admin-sidebar">
            <NavMenu />
        </aside>
        <main id="main-content" class="admin-content">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="pulse-card admin-error" role="alert">
                        <h1>Pulse could not load this workspace</h1>
                        <p>Reload the page and try again.</p>
                        <a class="pulse-button pulse-button-primary" href="/">Return to instructor home</a>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#592A8A",
            Secondary = "#FDC82F",
            Background = "#F7F5F8",
            Surface = "#FFFFFF",
            TextPrimary = "#211C27",
            TextSecondary = "#625B68",
            AppbarBackground = "#321653",
            AppbarText = "#FFFFFF"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "6px"
        }
    };
}
