@page "/"
@inject IConfiguration Configuration

<PageTitle>Pulse | Anonymous classroom surveys</PageTitle>

<main id="main-content">
    <section class="student-hero" aria-labelledby="student-hero-title">
        <div class="pulse-page student-hero-grid">
            <div class="student-hero-copy">
                <p class="pulse-eyebrow">Classroom feedback</p>
                <h1 id="student-hero-title" class="pulse-heading">Share what you think. No name required.</h1>
                <p class="pulse-lead">
                    Join an anonymous survey from your instructor. Your responses help shape the
                    conversation without identifying you.
                </p>
                <ul class="privacy-list" aria-label="Survey privacy">
                    <li>No account or student name</li>
                    <li>One current response per question</li>
                    <li>Class results appear only when your instructor reveals them</li>
                </ul>
            </div>
            <aside class="pulse-card join-card" aria-labelledby="join-title">
                <p class="pulse-eyebrow">Have a code?</p>
                <h2 id="join-title">Join your survey</h2>
                <JoinSurveyForm />
                <p class="scan-note">Scanning your instructor's QR code takes you directly to the survey.</p>
            </aside>
        </div>
    </section>

    <section class="pulse-page how-it-works" aria-labelledby="how-title">
        <div>
            <p class="pulse-eyebrow">How Pulse works</p>
            <h2 id="how-title">A clear view of the room</h2>
        </div>
        <div class="steps-grid">
            <article>
                <span aria-hidden="true">01</span>
                <h3>Join</h3>
                <p>Scan the QR code or enter the short code your instructor shares.</p>
            </article>
            <article>
                <span aria-hidden="true">02</span>
                <h3>Respond</h3>
                <p>Complete the survey on one mobile-friendly page and submit once.</p>
            </article>
            <article>
                <span aria-hidden="true">03</span>
                <h3>See the pulse</h3>
                <p>View anonymous class results after your instructor reveals them.</p>
            </article>
        </div>
    </section>

    <section class="pulse-page how-it-works" aria-labelledby="contribute-title">
        <div>
            <p class="pulse-eyebrow">Question bank</p>
            <h2 id="contribute-title">Have a good question?</h2>
            <p>Suggest one anonymously. An instructor will review it before it becomes available.</p>
        </div>
        <a class="pulse-button pulse-button-secondary" href="/suggest-question">Suggest a question</a>
    </section>

    <section class="instructor-callout" aria-labelledby="instructor-title">
        <div class="pulse-page">
            <div>
                <p class="pulse-eyebrow">For instructors</p>
                <h2 id="instructor-title">Create and share anonymous classroom surveys.</h2>
            </div>
            <a class="pulse-button pulse-button-outline" href="@InstructorUrl">Open instructor workspace</a>
        </div>
    </section>
</main>

@code {
    private string InstructorUrl =>
        Configuration["Admin:BaseUrl"] ?? "https://localhost:7019";
}
