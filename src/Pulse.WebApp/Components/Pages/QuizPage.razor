@page "/quiz/{JoinCode}"
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using Pulse.Domain.Entities
@using Pulse.Shared.Contracts.V1
@using Pulse.Shared.Services
@using Pulse.WebApp.Services
@implements IAsyncDisposable
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IDeviceIdService DeviceIdService
@inject ILogger<QuizPage> Logger
@inject IServiceProvider Services

<PageTitle>Anonymous survey | Pulse</PageTitle>

<main id="main-content" class="pulse-page survey-page">
    @if (isLoading)
    {
        <section class="pulse-card survey-status" aria-live="polite">
            <h1>Opening your survey</h1>
            <p>Please wait while Pulse loads the questions.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <section class="pulse-card survey-status" role="alert">
            <h1>Unable to open survey</h1>
            <p>@loadError</p>
            <a class="pulse-button pulse-button-primary" href="/">Try another code</a>
        </section>
    }
    else if (isSubmitted)
    {
        @if (revealedResults is null)
        {
            <section class="pulse-card survey-status" aria-live="polite">
                <p class="pulse-eyebrow">Response received</p>
                <h1>Survey submitted</h1>
                <p>Your anonymous responses have been recorded.</p>
                <p>The results are currently hidden. This page will update when your instructor reveals aggregate results.</p>
            </section>
        }
        else
        {
            <header class="survey-header" aria-live="polite">
                <p class="pulse-eyebrow">Results revealed</p>
                <h1>@revealedResults.Title</h1>
                <p>These aggregate results include responses from the class.</p>
            </header>
            <section class="survey-results">
                @foreach (var question in revealedResults.Questions)
                {
                    <article class="pulse-card survey-result">
                        <h2>@question.Text</h2>
                        <p>@question.ResponseCount responses</p>
                        @foreach (var tally in question.Tallies)
                        {
                            <div class="survey-result-row">
                                <div><span>@tally.Value</span><strong>@tally.Count</strong></div>
                                <progress value="@tally.Count" max="@Math.Max(1, question.ResponseCount)"></progress>
                            </div>
                        }
                    </article>
                }
            </section>
        }
    }
    else
    {
        <header class="survey-header">
            <p class="pulse-eyebrow">Anonymous survey</p>
            <h1>@surveyTitle</h1>
            <p>Answer every question, review your selections, and submit once at the end.</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(submissionError))
        {
            <div class="pulse-alert pulse-alert-error" role="alert">@submissionError</div>
        }

        <form @onsubmit="SubmitSurveyAsync" @onsubmit:preventDefault>
            <div class="survey-questions">
                @foreach (var question in questions)
                {
                    <fieldset class="pulse-card survey-question">
                        <legend>@question.Text</legend>

                        @switch (question.Type)
                        {
                            case QuestionType.MultipleChoice:
                                @foreach (var option in question.Options)
                                {
                                    <label class="survey-option">
                                        <input type="radio"
                                               name="@($"question-{question.Id}")"
                                               value="@option"
                                               checked="@(singleAnswers.GetValueOrDefault(question.Id) == option)"
                                               @onchange="@(_ => SetSingleAnswer(question.Id, option))" />
                                        <span>@option</span>
                                    </label>
                                }
                                break;

                            case QuestionType.MultipleAnswer:
                                @foreach (var option in question.Options)
                                {
                                    <label class="survey-option">
                                        <input type="checkbox"
                                               value="@option"
                                               checked="@GetMultipleAnswers(question.Id).Contains(option)"
                                               @onchange="@(_ => ToggleMultipleAnswer(question.Id, option))" />
                                        <span>@option</span>
                                    </label>
                                }
                                break;

                            case QuestionType.TrueFalse:
                                @foreach (var option in TrueFalseOptions)
                                {
                                    <label class="survey-option">
                                        <input type="radio"
                                               name="@($"question-{question.Id}")"
                                               value="@option"
                                               checked="@(singleAnswers.GetValueOrDefault(question.Id) == option)"
                                               @onchange="@(_ => SetSingleAnswer(question.Id, option))" />
                                        <span>@option</span>
                                    </label>
                                }
                                break;

                            case QuestionType.Matching:
                                @foreach (var pair in question.MatchingPairs)
                                {
                                    <label class="matching-row">
                                        <span>@pair.Prompt</span>
                                        <select value="@GetMatchingAnswer(question.Id, pair.Prompt)"
                                                @onchange="@(args => SetMatchingAnswer(question.Id, pair.Prompt, args.Value?.ToString()))">
                                            <option value="">Select a match</option>
                                            @foreach (var choice in question.Options)
                                            {
                                                <option value="@choice">@choice</option>
                                            }
                                        </select>
                                    </label>
                                }
                                break;
                        }
                    </fieldset>
                }
            </div>

            <button type="submit"
                    class="pulse-button pulse-button-primary submit-survey"
                    data-testid="submit-survey"
                    disabled="@isSubmitting">
                @(isSubmitting ? "Submitting..." : "Submit survey")
            </button>
        </form>
    }
</main>

@code {
    private static readonly string[] TrueFalseOptions = ["True", "False"];

    [Parameter]
    public string JoinCode { get; set; } = string.Empty;

    private readonly Dictionary<Guid, string> singleAnswers = [];
    private readonly Dictionary<Guid, HashSet<string>> multipleAnswers = [];
    private readonly Dictionary<(Guid QuestionId, string Prompt), string> matchingAnswers = [];
    private List<StudentQuestionResponse> questions = [];
    private Guid sessionId;
    private string surveyTitle = "Survey";
    private string? loadError;
    private string? submissionError;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isSubmitted;
    private readonly CancellationTokenSource lifetime = new();
    private SessionRealtimeConnection? realtimeConnection;
    private StudentSurveyResultsResponse? revealedResults;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var normalizedCode = JoinCode.Trim().ToUpperInvariant();
            if (string.IsNullOrWhiteSpace(normalizedCode))
            {
                loadError = "Enter a survey code to continue.";
                return;
            }

            var sessionResponse = await Http.GetAsync(
                $"/api/sessions/join/{Uri.EscapeDataString(normalizedCode)}");
            if (!sessionResponse.IsSuccessStatusCode)
            {
                loadError = sessionResponse.StatusCode == HttpStatusCode.Conflict
                    ? "This survey is not currently accepting responses."
                    : "That survey code is not available. Check the code with your instructor.";
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<JoinSessionResponse>();
            if (session is null)
            {
                loadError = "Pulse could not read the survey information.";
                return;
            }

            sessionId = session.Id;
            surveyTitle = session.Title;

            var questionsResponse = await Http.GetAsync($"/api/sessions/{sessionId}/questions");
            if (!questionsResponse.IsSuccessStatusCode)
            {
                loadError = "Pulse could not load the survey questions.";
                return;
            }

            questions = (await questionsResponse.Content.ReadFromJsonAsync<List<StudentQuestionResponse>>() ?? [])
                .OrderBy(question => question.SortOrder)
                .ToList();
            if (questions.Count == 0)
                loadError = "This survey does not have any questions.";
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Unable to connect while loading survey {JoinCode}", JoinCode);
            loadError = "Pulse could not connect. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetSingleAnswer(Guid questionId, string answer) =>
        singleAnswers[questionId] = answer;

    private HashSet<string> GetMultipleAnswers(Guid questionId)
    {
        if (!multipleAnswers.TryGetValue(questionId, out var answers))
        {
            answers = [];
            multipleAnswers[questionId] = answers;
        }

        return answers;
    }

    private void ToggleMultipleAnswer(Guid questionId, string answer)
    {
        var answers = GetMultipleAnswers(questionId);
        if (!answers.Add(answer))
            answers.Remove(answer);
    }

    private string GetMatchingAnswer(Guid questionId, string prompt) =>
        matchingAnswers.GetValueOrDefault((questionId, prompt), string.Empty);

    private void SetMatchingAnswer(Guid questionId, string prompt, string? answer)
    {
        if (string.IsNullOrWhiteSpace(answer))
            matchingAnswers.Remove((questionId, prompt));
        else
            matchingAnswers[(questionId, prompt)] = answer;
    }

    private async Task SubmitSurveyAsync()
    {
        submissionError = null;
        var answers = new List<SurveyAnswerRequest>();
        foreach (var question in questions)
        {
            var values = GetValues(question);
            if (values.Count == 0 ||
                question.Type == QuestionType.Matching &&
                values.Count != question.MatchingPairs.Count)
            {
                submissionError = "Answer every question before submitting.";
                return;
            }

            answers.Add(new SurveyAnswerRequest(question.Id, values));
        }

        isSubmitting = true;
        try
        {
            var deviceId = await DeviceIdService.GetDeviceIdAsync();
            var response = await Http.PostAsJsonAsync(
                $"/api/sessions/{sessionId}/submit",
                new SubmitSurveyRequest(deviceId, answers));
            if (!response.IsSuccessStatusCode)
            {
                submissionError = response.StatusCode == HttpStatusCode.Conflict
                    ? "This survey is no longer accepting responses."
                    : "Pulse could not submit your survey. Review your answers and try again.";
                return;
            }

            isSubmitted = true;
            await BeginResultsMonitoringAsync();
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Unable to submit survey {SessionId}", sessionId);
            submissionError = "Pulse could not connect. Your answers were not submitted.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private IReadOnlyList<string> GetValues(StudentQuestionResponse question) =>
        question.Type switch
        {
            QuestionType.MultipleChoice or QuestionType.TrueFalse =>
                singleAnswers.TryGetValue(question.Id, out var answer) ? [answer] : [],
            QuestionType.MultipleAnswer =>
                question.Options.Where(option => GetMultipleAnswers(question.Id).Contains(option)).ToList(),
            QuestionType.Matching =>
                question.MatchingPairs
                    .Select(pair => GetMatchingAnswer(question.Id, pair.Prompt))
                    .Where(answer => !string.IsNullOrWhiteSpace(answer))
                    .ToList(),
            _ => []
        };

    private async Task BeginResultsMonitoringAsync()
    {
        await LoadStudentResultsAsync();

        var factory = Services.GetService<SessionRealtimeConnectionFactory>();
        if (factory is not null)
        {
            realtimeConnection = factory.Create(
                _ => Task.CompletedTask,
                () => InvokeAsync(StateHasChanged),
                () => InvokeAsync(LoadStudentResultsAsync));
            try
            {
                await realtimeConnection.StartAsync(sessionId, lifetime.Token);
            }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
            {
                Logger.LogWarning(ex, "Live result updates unavailable for survey {SessionId}; polling will continue", sessionId);
            }
        }

        _ = PollForResultsAsync();
    }

    private async Task PollForResultsAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (revealedResults is null && await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(LoadStudentResultsAsync);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
    }

    private async Task LoadStudentResultsAsync()
    {
        try
        {
            var response = await Http.GetAsync(
                $"/api/sessions/{sessionId}/results/student",
                lifetime.Token);
            if (!response.IsSuccessStatusCode)
                return;

            var json = await response.Content.ReadAsStringAsync(lifetime.Token);
            using var document = JsonDocument.Parse(json);
            if (!document.RootElement.TryGetProperty("questions", out _))
                return;

            revealedResults = JsonSerializer.Deserialize<StudentSurveyResultsResponse>(
                json,
                new JsonSerializerOptions(JsonSerializerDefaults.Web));
            await InvokeAsync(StateHasChanged);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Unable to refresh student results for survey {SessionId}", sessionId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        if (realtimeConnection is not null)
            await realtimeConnection.DisposeAsync();
        lifetime.Dispose();
    }

    private sealed record JoinSessionResponse(Guid Id, string Title, string JoinCode);
}
