@page "/student-join"

<PageTitle>Join a survey | Pulse</PageTitle>

<main id="main-content" class="pulse-page join-page">
    <a href="/" class="back-link">Back to Pulse</a>
    <section class="pulse-card join-panel" aria-labelledby="join-page-title">
        <p class="pulse-eyebrow">Anonymous classroom survey</p>
        <h1 id="join-page-title">Join a survey</h1>
        <p>Enter the code shown by your instructor. You do not need an account.</p>
        <JoinSurveyForm />
    </section>
</main>
