@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<a class="pulse-skip-link" href="#main-content">Skip to main content</a>
<div class="student-shell">
    <header class="student-header">
        <div class="student-header-inner">
            <a class="pulse-brand" href="/" aria-label="Pulse home">
                <img src="/images/pulse_logo.png" height="100" alt="Pulse logo" />
            </a>
            <span class="student-header-purpose">Anonymous classroom surveys</span>
        </div>
    </header>
    <ErrorBoundary>
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent>
            <main id="main-content" class="pulse-page">
                <div class="pulse-card error-card" role="alert">
                    <h1>Pulse could not load this page</h1>
                    <p>Try reloading. If the problem continues, ask your instructor for help.</p>
                    <a class="pulse-button pulse-button-primary" href="/">Return home</a>
                </div>
            </main>
        </ErrorContent>
    </ErrorBoundary>

    <footer class="pulse-footer">
        <span>Forged with <span class="pulse-footer-accent">💜</span> by Pirate Forge and <span class="pulse-footer-accent">Hack &amp; Plunder</span></span>
    </footer>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#592A8A",
            Secondary = "#FDC82F",
            Background = "#F7F5F8",
            Surface = "#FFFFFF",
            TextPrimary = "#211C27",
            TextSecondary = "#625B68",
            AppbarBackground = "#321653",
            AppbarText = "#FFFFFF"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "6px"
        }
    };
}
