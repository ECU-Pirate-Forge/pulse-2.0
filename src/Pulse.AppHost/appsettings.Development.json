{
  "DevTunnels": {
    "Enabled": true,
    "CliPath": "devtunnel",
    "StartupTimeoutSeconds": 60,
    "ReconnectTimeoutSeconds": 60,
    "Services": {
      "webapi": { "TunnelId": "pulse-beastmaster-webapi", "Port": 5062 },
      "webadmin": { "TunnelId": "pulse-beastmaster-webadmin", "Port": 5049 },
      "webapp": { "TunnelId": "pulse-beastmaster-webapp", "Port": 5243 }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/v1",
    "Model": "gemma4:latest",
    "EmbeddingModel": "embeddinggemma:latest"
  },
  "Security": {
    "InstructorCode": "TEST-INSTRUCTOR-CODE",
    "AdminCode": "TEST-ADMIN-CODE"
  },
  "ConnectionStrings": {
    "pulse-db": "Filename=pulse.db;Connection=shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
